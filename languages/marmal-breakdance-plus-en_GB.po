msgstr "One line = one cookie: name | provider | purpose | duration | category (nezbytne, preferencni, analyticke, marketingove)."

#: modules/cookies/includes/admin.php:220
msgid "Zapomenout nalezené služby"
msgstr "Forget found services"

#: modules/cookies/includes/admin.php:221
