msgstr "Waiting for migration"

#: includes/moduly.php:263
msgid "Chybí Breakdance"
msgstr "Breakdance missing"

#: includes/moduly.php:267
msgid "MarMal – moduly"
msgstr "MarMal – modules"

#: includes/moduly.php:268
msgid "Zapni jen to, co tento web používá. Vypnutý modul nenačte žádný kód, CSS ani JavaScript."
msgstr "Turn on only what this website uses. A module that is off loads no code, CSS or JavaScript."

#: includes/moduly.php:285
msgid "Vždy zapnuto"
msgstr "Always on"

#: includes/moduly.php:293
#, php-format
msgid "Na webu ještě běží starý plugin %s, proto se modul nenačítá. Převod starý plugin deaktivuje a zapne modul – nastavení i třídy na stránkách zůstanou."
msgstr "The old %s plugin is still running on this website, so the module does not load. Migration deactivates the old plugin and turns the module on – settings and classes on pages are kept."

#: includes/moduly.php:297
msgid "Modul potřebuje aktivní Breakdance."
msgstr "The module requires an active Breakdance."

