#: marmal-breakdance-plus.php:92
msgid "Plugin potřebuje aktivní Breakdance. Elementy se nenačtou (modul Efekty funguje i bez něj)."
msgstr "The plugin requires an active Breakdance. Elements will not load (the Effects module works without it)."

#: modules/galerie/manifest.php:25
msgid "Galerie Plus"
msgstr "Gallery Plus"

#: modules/galerie/manifest.php:26
msgid "Breakdance element: mozaika se zarovnanými okraji (20 vzorů) nebo slider s miniaturami, efekty po najetí, video dlaždice a vlastní lightbox. CSS a JS se načítá jen na stránkách s galerií."
msgstr "Breakdance element: an aligned-edge mosaic (20 patterns) or a slider with thumbnails, hover effects, video tiles and a custom lightbox. CSS and JS load only on pages with a gallery."

#: modules/efekty/manifest.php:37
msgid "Efekty"
msgstr "Effects"

#: modules/efekty/manifest.php:38
msgid "Knihovna CSS efektů (rámečky, tlačítka, karty, obrázky, hero, animovaná pozadí, animace při scrollu). Efekt se zapne třídou mm-… v poli Classes. Nahrazuje plugin MarMal Effects."
msgstr "A library of CSS effects (borders, buttons, cards, images, hero, animated backgrounds, scroll animations). Turn an effect on with an mm-… class in the Classes field. Replaces the MarMal Effects plugin."

#: modules/efekty/manifest.php:45
msgid "Galerie efektů"
msgstr "Effects gallery"

#: modules/efekty/manifest.php:46
msgid "Nastavení"
msgstr "Settings"

#: modules/efekty/manifest.php:56
#, php-format
msgid "Načítá se %1$d z %2$d kategorií efektů."
msgstr "Loading %1$d of %2$d effect categories."

#: includes/gallery.php:222
msgid "Videovizualizace"
msgstr "Video tour"

#: includes/gallery.php:255
msgid "Galerie Plus: ACF pole je prázdné nebo nenalezené. Na webu se zobrazí obrázky aktuálního příspěvku (v šabloně nastavte náhledový příspěvek)."
msgstr "Galerie Plus: the ACF field is empty or was not found. The site will show the images of the current post (set a preview post in the template)."

#: includes/gallery.php:256
msgid "Galerie Plus: vyberte obrázky v záložce Content → Obrázky."
msgstr "Galerie Plus: select images in Content → Obrázky."

