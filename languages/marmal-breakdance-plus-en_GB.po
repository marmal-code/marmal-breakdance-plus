#: includes/moduly.php:232
msgid "Nemáš oprávnění."
msgstr "You do not have permission."

#: includes/moduly.php:253
msgid "Modul je zapnutý."
msgstr "The module is on."

#: includes/moduly.php:254
msgid "Modul je vypnutý – jeho kód ani CSS se už nenačítají."
msgstr "The module is off – its code and CSS no longer load."

#: includes/moduly.php:255
msgid "Hotovo: starý plugin je deaktivovaný a modul zapnutý. Nastavení zůstalo. Starý plugin teď můžeš v Pluginech smazat."
msgstr "Done: the old plugin is deactivated and the module is on. Settings were kept. You can now delete the old plugin in Plugins."

#: includes/moduly.php:256
msgid "Změnu se nepodařilo uložit."
msgstr "The change could not be saved."

