msgid "Znakové sady"
msgstr "Character sets"

#: modules/fonty/includes/admin.php:143
msgid "Latinka včetně češtiny (vždy)"
msgstr "Latin including Czech (always)"

#: modules/fonty/includes/admin.php:147
