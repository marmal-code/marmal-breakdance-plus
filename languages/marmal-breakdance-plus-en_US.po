#: modules/cookies/manifest.php:25 modules/cookies/includes/admin.php:26 modules/cookies/includes/admin.php:26
msgid "Cookies"
msgstr "Cookies"

#: modules/cookies/manifest.php:26
msgid "Cookie lišta podle pravidel ÚOOÚ: souhlas předem, Odmítnout vše v první vrstvě, okno nastavení po kategoriích, Google Consent Mode v2, GA4, blokování skriptů a náhledy videí a map do souhlasu, seznam cookies a záznam souhlasů. Vzhled z Global Settings Breakdance."
msgstr "Cookie banner following the Czech DPA (ÚOOÚ) rules: prior consent, Reject all in the first layer, preferences by category, Google Consent Mode v2, GA4, script blocking and video/map placeholders until consent, cookie list and consent log. Look taken from Breakdance Global Settings."

#: modules/cookies/manifest.php:32
msgid "Náhled na webu"
msgstr "Preview on the website"

#: modules/cookies/manifest.php:41
#, php-format
msgid "Pozor: běží i %s – vypni ho, jinak budou na webu dvě lišty."
msgstr "Warning: %s is also running – deactivate it, otherwise the website will show two banners."

#: modules/cookies/includes/admin.php:41
msgid "Web pořád načítá některé fonty z Googlu, i když je modul Fonty zapnutý – podívej se do MarMal → Fonty a vyčisti cache."
msgstr "The website still loads some fonts from Google although the Fonts module is on – check MarMal → Fonts and clear the cache."

#: modules/cookies/includes/admin.php:42
msgid "Web načítá Google Fonts ze serverů Googlu – Google tak dostává IP adresy návštěvníků (GDPR). Zapni modul Fonty v MarMal → Moduly, fonty se pak načítají z tvého webu."
msgstr "The website loads Google Fonts from Google servers – Google gets visitors’ IP addresses (GDPR). Turn on the Fonts module in MarMal → Modules, fonts then load from your website."

#: modules/cookies/includes/admin.php:48
msgid "Ikonka cookies je skrytá a na webu jsme v posledních 7 dnech nenašli odkaz „Nastavení cookies“. Návštěvník tak nemá jak změnit nebo odvolat souhlas (ÚOOÚ: odkaz v patičce je minimum). Přidej do patičky element Marmal – Patička, nebo zapni ikonku v MarMal → Cookies → Vzhled."
msgstr "The cookie icon is hidden and in the last 7 days we did not find a “Cookie settings” link on the website. Visitors have no way to change or withdraw consent (ÚOOÚ: a footer link is the minimum). Add the Marmal – Footer element to the footer, or turn the icon on in MarMal → Cookies → Appearance."

#: modules/cookies/includes/admin.php:57
#, php-format
msgid "Na webu běží i %s. Vypni ho v Pluginech, jinak budou návštěvníci vidět dvě cookie lišty."
msgstr "%s is also running on the website. Deactivate it in Plugins, otherwise visitors will see two cookie banners."

