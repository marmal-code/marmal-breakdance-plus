#: marmal-breakdance-plus.php:93
msgid "Plugin potřebuje aktivní Breakdance. Elementy se nenačtou (modul Efekty funguje i bez něj)."
msgstr "The plugin requires an active Breakdance. Elements will not load (the Effects module works without it)."

#: modules/galerie/manifest.php:25
msgid "Galerie Plus"
msgstr "Gallery Plus"

#: modules/galerie/manifest.php:26
msgid "Breakdance element: mozaika se zarovnanými okraji (20 vzorů) nebo slider s miniaturami, efekty po najetí, video dlaždice a vlastní lightbox. CSS a JS se načítá jen na stránkách s galerií."
msgstr "Breakdance element: an aligned-edge mosaic (20 patterns) or a slider with thumbnails, hover effects, video tiles and a custom lightbox. CSS and JS load only on pages with a gallery."

#: modules/hero/manifest.php:26
msgid "superHERO"
msgstr "superHERO"

#: modules/hero/manifest.php:27
msgid "Breakdance element pro úvodní sekci: 5 rozložení, pozadí z fotky, videa, slideru nebo živého přechodu, tlačítka s efekty, důvěra, otevírací doba, masky obrázků, dividery a typografie každého prvku. JS se načítá jen na stránkách s elementem."
msgstr "Breakdance element for the hero section: 5 layouts, photo, video, slider or animated gradient background, buttons with effects, trust signals, opening hours, image masks, dividers and typography for every part. JS loads only on pages with the element."

#: modules/fonty/manifest.php:23 modules/fonty/includes/admin.php:22 modules/fonty/includes/admin.php:22 modules/fonty/includes/admin.php:107
msgid "Fonty"
msgstr "Fonts"

#: modules/fonty/manifest.php:24
msgid "Google Fonts z webu stáhne k sobě a návštěvníkům je posílá z vlastní domény – Google nedostane jejich IP adresu (GDPR) a stránka se načte rychleji. Fonty dál vybíráš v Breakdance jako dosud."
msgstr "Downloads the website’s Google Fonts and serves them to visitors from your own domain – Google does not get their IP address (GDPR) and pages load faster. You keep choosing fonts in Breakdance as before."

#: modules/fonty/manifest.php:29 modules/fonty/includes/admin.php:144 modules/obrazky/manifest.php:31 modules/seo/manifest.php:30 modules/gdpr/manifest.php:28 modules/cookies/manifest.php:31 modules/cookies/includes/data.php:279 modules/efekty/manifest.php:46 modules/presmerovani/manifest.php:29 modules/presmerovani/includes/admin.php:224 modules/paticka/manifest.php:32
msgid "Nastavení"
msgstr "Settings"

#: modules/fonty/manifest.php:41
msgid "Některé fonty se nepodařilo stáhnout – načítají se dál z Googlu. Podrobnosti v MarMal → Fonty."
msgstr "Some fonts could not be downloaded – they still load from Google. Details in MarMal → Fonts."

#: modules/fonty/manifest.php:44
msgid "Písmo z Global Settings není mezi staženými – nic se nepřednačítá. Podrobnosti v MarMal → Fonty."
msgstr "A font from Global Settings is not among the downloaded files – nothing is preloaded. Details in MarMal → Fonts."

#: modules/fonty/includes/admin.php:45 modules/fonty/includes/admin.php:58 modules/obrazky/includes/admin.php:58 modules/gdpr/includes/admin.php:148 modules/gdpr/includes/admin.php:158 modules/cookies/includes/souhlasy.php:213 modules/cookies/includes/souhlasy.php:236 modules/cookies/includes/souhlasy.php:251 modules/cookies/includes/zasady.php:204
msgid "Nemáte oprávnění."
msgstr "You do not have permission."

#: modules/fonty/includes/admin.php:87
msgid "MarMal – Fonty"
msgstr "MarMal – Fonts"

#: modules/fonty/includes/admin.php:88
msgid "Google Fonts se na web načítají z vlastní domény: Google nedostane IP adresy návštěvníků (GDPR) a stránka se načte rychleji. Fonty dál vybíráš v Breakdance jako dosud – modul je při první návštěvě stránky stáhne sám. V builderu se fonty načítají z Googlu dál (vidíš to jen ty)."
msgstr "Google Fonts load from your own domain: Google does not get visitors’ IP addresses (GDPR) and pages load faster. You keep choosing fonts in Breakdance as before – the module downloads them on the first page visit. In the builder fonts still load from Google (only you see that)."

#: modules/fonty/includes/admin.php:92
msgid "Úvodní stránka prošla, nalezené fonty jsou stažené a cache je vyčištěná."
msgstr "The home page was checked, found fonts are downloaded and the cache is cleared."

#: modules/fonty/includes/admin.php:94
msgid "Fonty smazány a znovu stažené z úvodní stránky. Fonty z ostatních stránek se stáhnou při jejich první návštěvě."
msgstr "Fonts deleted and downloaded again from the home page. Fonts from other pages are downloaded on their first visit."

#: modules/fonty/includes/admin.php:96
msgid "Fonty smazány. Stáhnou se znovu při první návštěvě webu."
msgstr "Fonts deleted. They will be downloaded again on the next visit."

#: modules/fonty/includes/admin.php:100
#, php-format
msgid "Web se nepodařilo projít z administrace (%s). Nevadí – otevři web v anonymním okně, fonty se stáhnou při první návštěvě."
msgstr "The website could not be checked from the administration (%s). No problem – open the website in a private window, fonts are downloaded on the first visit."

#: modules/fonty/includes/admin.php:104
msgid "Fonty na webu"
msgstr "Fonts on the website"

#: modules/fonty/includes/admin.php:108 modules/obrazky/includes/admin.php:344 modules/gdpr/includes/admin.php:218 modules/presmerovani/includes/admin.php:527
