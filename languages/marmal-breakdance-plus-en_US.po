#: modules/paticka/includes/admin.php:293
msgid "Jak to dát do patičky"
msgstr "How to add it to the footer"

#: modules/paticka/includes/admin.php:295
msgid "Breakdance → Footers → otevři patičku webu."
msgstr "Breakdance → Footers → open the website footer."

#: modules/paticka/includes/admin.php:296
msgid "Do spodní lišty přidej element „Marmal – Patička“ (Add → do hledání napiš „Patička“)."
msgstr "Add the “Marmal – Patička” element to the bottom bar (Add → search for “Patička”)."

#: modules/paticka/includes/admin.php:297
msgid "Content → Patička: rozložení a co zobrazit. Design: barvy, písmo a podtržení odkazů (i zvlášť pro odkaz autora), copyright, údaje o podnikateli, mezery."
msgstr "Content → Patička: layout and what to show. Design: colors, font and underline of links (separately for the author link too), copyright, business details, spacing."

#: modules/paticka/includes/admin.php:299
msgid "Bez elementu to jde i shortcodem <code>[marmal_paticka]</code> v elementu Shortcode – vzhled se pak jen převezme z patičky."
msgstr "Without the element you can use the <code>[marmal_paticka]</code> shortcode in a Shortcode element – the styling is then taken from the footer."

#: modules/paticka/includes/admin.php:300
msgid "Jednotlivé části (každou do vlastního elementu Shortcode):"
msgstr "Individual parts (each in its own Shortcode element):"

#: modules/paticka/includes/admin.php:302
msgid "© 2019–2026 Název; drzitel=\"ne\" = jen roky"
msgstr "© 2019–2026 Name; drzitel=\"ne\" = years only"

#: modules/paticka/includes/admin.php:303
msgid "podpis autora s odkazem"
msgstr "author credit with link"

#: modules/paticka/includes/admin.php:304
msgid "údaje o podnikateli; pod_sebou=\"ano\" = každý údaj na řádek"
msgstr "business details; pod_sebou=\"ano\" = one detail per line"

#: modules/paticka/includes/admin.php:305
msgid "ochrana osobních údajů, zásady cookies a nastavení cookies; zasady=\"ne\" / zasady_cookies=\"ne\" / cookies=\"ne\""
msgstr "privacy policy, cookie policy and cookie settings; zasady=\"ne\" / zasady_cookies=\"ne\" / cookies=\"ne\""

#: modules/paticka/includes/admin.php:306
msgid "celá lišta na střed (radek = vlevo a vpravo, sloupec = pod sebou); části vypneš copyright=\"ne\", firma=\"ne\", odkazy=\"ne\", autor=\"ne\""
msgstr "whole bar centered (radek = left and right, sloupec = stacked); turn parts off with copyright=\"ne\", firma=\"ne\", odkazy=\"ne\", autor=\"ne\""

#: modules/paticka/includes/admin.php:307
msgid "copyright vlevo, zásady a cookies uprostřed, podpis vpravo; přesun části pozice_copyright / pozice_odkazy / pozice_autor / pozice_udaje=\"vlevo|stred|vpravo|pod\", zarovnání řádku pod zarovnani_pod=\"vlevo|stred|vpravo\", pod sebe od skladat=\"mobil|tablet|maly|nikdy\", mobil=\"stred\""
msgstr "copyright on the left, privacy and cookies in the center, credit on the right; move a part with pozice_copyright / pozice_odkazy / pozice_autor / pozice_udaje=\"vlevo|stred|vpravo|pod\", align the row below with zarovnani_pod=\"vlevo|stred|vpravo\", stack from skladat=\"mobil|tablet|maly|nikdy\", mobil=\"stred\""

#: modules/paticka/includes/admin.php:309
msgid "Dynamická data: u textu klikni na ikonu dynamických dat → MarMal → Patička (copyright, roky, údaje o podnikateli, odkazy)."
msgstr "Dynamic data: click the dynamic data icon on a text → MarMal → Footer (copyright, years, business details, links)."

